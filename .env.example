# TypeSafe (Jev)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Which models run through the pipeline in parallel (comma-separated): jev, mock, random
MODELS=jev,mock,random

# Universe: leave SYMBOLS empty to auto-select Binance USDT perps tagged "Meme" by 24h volume
SYMBOLS=
MAX_SYMBOLS=20
MIN_QUOTE_VOLUME_24H=20000000

# Decision loop
DECISION_INTERVAL_MS=30000
MAX_CALLS_PER_ROUND=8
MODEL_TIMEOUT_MS=4000

# Triple-barrier question
BARRIER_PCT=0.5
HORIZON_MIN=5
ASK_REGIME=true
# Question wordings asked in the same request (one decision row per wording). tb-v1 carries
# strategy hints, tb-v2 is goal/horizon/cost only. Wording-blind baselines answer the first one.
QUESTION_VERSIONS=tb-v1,tb-v2

# Cost context (bps). Fees are overridden by GET /fapi/v1/commissionRate when API keys are set.
TAKER_FEE_BPS=5
MAKER_FEE_BPS=2
SLIPPAGE_BPS_PER_SIDE=10
BINANCE_API_KEY=
BINANCE_API_SECRET=

DB_PATH=./data/ledger.sqlite
LOG_LEVEL=info
